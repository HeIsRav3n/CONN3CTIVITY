# ──────────────────────────────────────────────────────
# Supabase — frontend (safe to expose; used for Auth + profiles)
# ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ──────────────────────────────────────────────────────
# Neon — SERVER-SIDE ONLY (never use VITE_ prefix)
# Used by /api/* on Vercel and by discord-bot.cjs / fetchDiscordMap.cjs
# Also loaded by vite for local /api via vite-plugin-local-api
# ──────────────────────────────────────────────────────
NEON_DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# ──────────────────────────────────────────────────────
# Discord Bot — SERVER-SIDE ONLY (never commit real values)
# Used by discord-bot.cjs — keeps Neon stats/map/MVC fresh
# ──────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=Bot.your_bot_token_here
DISCORD_GUILD_ID=1265954062789120050
CONN3CTOR_ROLE_ID=1266023149359599617
MVC_ROLE_ID=1350853857701269534

# How often the bot full-syncs (milliseconds). Default: 60000 = 1 min
SYNC_INTERVAL_MS=60000

# Optional — Vercel cron auth for GET /api/sync (Hobby may run once/day; Pro can run every minute)
CRON_SECRET=generate_a_long_random_string

# Supabase service role — SERVER-SIDE ONLY (bot dual-writes for Realtime)
# Dashboard → Project Settings → API → service_role
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
